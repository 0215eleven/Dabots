    "expo-web-browser": "~58.0.6",
    "katex": "0.19.0",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299",
    "react-native-webview": "14.0.1",
    "zod": "4.6.7",
    "solid-js": "2.0.0-rc.18",
    "@solidjs/web": "2.0.0-rc.18"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.2",
    "@types/react-dom": "~19.3.0"
  },
  "overrides": {
    "@react-navigation/elements": "2.6.5",
    "@openpanel/react-native": {
      "expo-application": "$expo-application",
      "expo-constants": "$expo-constants"
    }
  },
  "workspaces": [
    "openbot/packages/brand",
    "openbot/packages/contracts",
    "openbot/packages/i18n",
    "openbot/packages/logging",
    "openbot/packages/team-client",
    "openbot/packages/telemetry",
    "openbot/packages/user-errors"
  ],
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-local-authentication",
          "expo-speech-recognition",
          "expo-device",
          "expo-web-browser",
          "expo-updates",
          "expo-keep-awake",
          "expo-media-library",
          "expo-video",
          "expo-audio",
          "expo-image-picker",
          "expo-speech",
          "expo-document-picker",
          "expo-image-manipulator"
        ]
      }
    }
  }
