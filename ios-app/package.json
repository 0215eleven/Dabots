{
  "name": "@ds-bot/mobile",
  "version": "0.1.10-pro.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release --device",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios",
    "test": "node --experimental-strip-types --test test/*.test.ts && python3 -m unittest discover -s test -p \"test_*.py\"",
    "patch": "node scripts/apply-patches.mjs"
  },
  "dependencies": {
    "@ds-bot/mobile-sdk": "file:./sdk",
    "@expo/metro-runtime": "~58.0.15",
