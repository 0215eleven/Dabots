    "@openbot/contracts": "file:./openbot/packages/contracts",
    "@openbot/i18n": "file:./openbot/packages/i18n",
    "@openbot/logging": "file:./openbot/packages/logging",
    "@openbot/team-client": "file:./openbot/packages/team-client",
    "@openbot/telemetry": "file:./openbot/packages/telemetry",
    "@openbot/user-errors": "file:./openbot/packages/user-errors",
    "@openpanel/react-native": "1.4.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.104.5",
    "effect": "4.0.6",
    "expo-application": "~58.1.2",
