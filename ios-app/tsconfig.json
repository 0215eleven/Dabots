{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./openbot/mobile/src/*"
      ],
      "@/assets/*": [
        "./openbot/mobile/assets/*"
      ],
      "@ds/*": [
        "./src/ds/*"
      ],
      "@legacy/*": [
        "./src/openbot/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "sdk/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "openbot/adaptations"
  ]
}
