{
  "expo": {
    "name": "Dabots",
    "slug": "ds-bot-mobile-app",
    "version": "0.1.10",
    "orientation": "portrait",
    "scheme": "dsbot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dsbot.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Connect securely to your paired Dabots computer on Wi-Fi.",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "app.dsbot.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fcfcfc"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Dabots"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#CDADEC",
          "image": "./assets/openbot/splash/eyes.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#756183",
            "image": "./assets/openbot/splash/eyes.png"
          },
          "android": {
            "imageWidth": 188
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/openbot/fonts/inter/Inter-Regular.ttf",
              "./assets/openbot/fonts/inter/Inter-Italic.ttf",
              "./assets/openbot/fonts/inter/Inter-Medium.ttf",
              "./assets/openbot/fonts/inter/Inter-SemiBold.ttf",
              "./assets/openbot/fonts/inter/Inter-Bold.ttf",
              "./assets/openbot/fonts/inter/Inter-BoldItalic.ttf",
              "./assets/openbot/fonts/inter/Inter-ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/openbot/fonts/inter/Inter-ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "widgets": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your computer’s pairing QR code to connect Dabots.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-notifications"
    ],
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "web"
    ]
  }
}
