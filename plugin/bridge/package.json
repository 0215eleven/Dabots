{
  "name": "ds-bot-mobile-bridge",
  "version": "0.0.9-pro.1",
  "description": "DeepSeek Bot Pro Bridge — secure pairing and scoped access to an existing DS Bot team",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "src/adapter.mjs",
    "src/auth.js",
    "src/config.mjs",
    "src/projection.js",
    "src/server.js",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh.md",
    "COMPATIBILITY.md",
    "config.schema.json",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "src/group-projection.mjs",
    "src/actions.mjs",
    "src/operator.mjs",
    "src/project-avatar.mjs",
    "src/live-state.mjs",
    "src/task-events.mjs",
    "src/remote-connection.mjs",
    "src/quick-tunnel.mjs",
    "src/relay-client.mjs",
    "src/relay-endpoint.mjs",
    "src/relay-shared.mjs",
    "THIRD_PARTY_RELAY_NOTICES.txt",
    "src/relay-settings.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs",
    "fixture": "node test/fixture-host.mjs",
    "lint": "oxlint --deny-warnings index.mjs src test",
    "test:delivery": "node test/delivery.mjs",
    "test:prepare": "node test/prepare.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxlint": "1.76.0"
  },
  "homepage": "https://github.com/0215eleven/ds-bot-mobile-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0215eleven/ds-bot-mobile-app.git",
    "directory": "bridge"
  },
  "bugs": {
    "url": "https://github.com/0215eleven/ds-bot-mobile-app/issues"
  }
}
